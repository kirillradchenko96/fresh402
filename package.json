{
  "name": "fresh402-public-resources",
  "private": true,
  "description": "Public documentation and source-client validation; no hosted backend or deployment",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:docs": "node scripts/check-public-docs.mjs",
    "check:live": "node examples/efficiency/read-only-smoke.ts",
    "test": "node --test scripts/*.test.mjs examples/efficiency/*.test.ts examples/knowledge-base/*.test.ts",
    "typecheck": "tsc --noEmit -p examples/efficiency/tsconfig.json && tsc --noEmit -p examples/knowledge-base/tsconfig.json",
    "docs:refresh": "node scripts/refresh-public-docs.mjs --write"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@types/node": "26.6.3",
    "mppx": "0.13.5",
    "typescript": "5.9.3",
    "viem": "2.57.1"
  }
}
