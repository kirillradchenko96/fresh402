{
  "name": "fresh402",
  "version": "2.0.0-rc.1",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest",
    "cf-typegen": "wrangler types --strict-vars false",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:run": "vitest --run",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "build:staging": "wrangler deploy --env staging --dry-run --outdir dist/staging",
    "test:tools": "node --test scripts/*.test.mjs",
    "staging:check": "node scripts/staging-check.mjs",
    "test:gateway": "node --test gateway/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^26.6.3",
    "patch-package": "^8.0.1",
    "typescript": "^5.5.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.143.0"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@modelcontextprotocol/server": "2.1.0",
    "@x402/core": "^2.27.0",
    "@x402/evm": "^2.27.0",
    "@x402/extensions": "^2.27.0",
    "@x402/hono": "^2.27.0",
    "@x402/mcp": "2.27.0",
    "entities": "8.1.0",
    "hono": "~4.13.13",
    "jose": "^6.2.12",
    "zod": "4.4.3",
    "viem": "2.56.9"
  },
  "overrides": {
    "undici": "7.29.1",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
